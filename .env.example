# Environment variables (copy to .env and fill in — never commit .env)

# Bright Data API token (Account Settings → API Tokens)
BRIGHT_DATA_API_TOKEN=

# JSON map of source -> collector ID, e.g. {"docker": "c_xxx", "kubernetes": "c_yyy"}
BRIGHTDATA_COLLECTOR_IDS={}

# LLM provider — choose the key you have (defaults to openrouter):
#   openrouter -> uses OPENROUTER_API_KEY for BOTH chat and embeddings
#   openai     -> uses OPENAI_API_KEY for BOTH chat and embeddings
FRESHDOCS_LLM_PROVIDER=openrouter

# --- OpenRouter key (needed if provider=openrouter) ---
OPENROUTER_API_KEY=

# --- OpenAI key (needed if provider=openai) ---
OPENAI_API_KEY=

# Optional model overrides (OpenRouter IDs by default).
# Free-tier chat example: nvidia/nemotron-3.5-lightning:free
FRESHDOCS_OPENROUTER_CHAT_MODEL=nvidia/nemotron-3.5-lightning:free
# Embedding model (OpenRouter /v1/embeddings): Qwen3 embedding
FRESHDOCS_OPENROUTER_EMBEDDING_MODEL=qwen/qwen3-embedding-8b

# Optional: where data lives (defaults to ./data)
FRESHDOCS_DATA_DIR=data
